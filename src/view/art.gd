class_name Art
extends RefCounted
## Texture registry. Everything here is generated by tools/gen_art.py.

const ENEMY_NAMES := ["drifter", "dart", "splitter", "mite", "weaver", "brute", "spitter", "bomber",
		"warden", "eclipse"]
## Enemy sprites are 128 px with the shape drawn at radius 40.
const SPRITE_R := 40.0

static var enemy: Array[Texture2D] = []
static var enemy_white: Array[Texture2D] = []
static var _cache := {}


static func ensure() -> void:
	if not enemy.is_empty():
		return
	for n in ENEMY_NAMES:
		enemy.append(load("res://assets/sprites/e_%s.png" % n))
		enemy_white.append(load("res://assets/sprites/w_%s.png" % n))


static func tex(name: String) -> Texture2D:
	if not _cache.has(name):
		_cache[name] = load("res://assets/sprites/%s.png" % name)
	return _cache[name]


static func icon(id: String) -> Texture2D:
	var path := "res://assets/sprites/i_%s.png" % id
	if not ResourceLoader.exists(path):
		path = "res://assets/sprites/i_flux.png"
	return tex(path.get_file().get_basename())


static func card_color(id: String) -> Color:
	var info := Defs.card_info(id)
	return info.get("color", Color.WHITE)
