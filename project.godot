; Engine configuration file.
config_version=5

[application]

config/name="Afterglow"
config/description="Survive the swarm. Become the light."
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon/icon_192.png"
boot_splash/bg_color=Color(0.016, 0.012, 0.04, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[audio]

driver/output_latency=30

[autoload]

Save="*res://src/autoload/save.gd"
Sfx="*res://src/autoload/sfx.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
viewport/hdr_2d=true
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.016, 0.012, 0.04, 1)
